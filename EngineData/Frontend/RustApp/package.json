{
  "name": "searchnow-tauri-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:app": "tauri dev",
    "build:frontend": "vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "validate:architecture": "node scripts/validate_architecture_contract.mjs",
    "validate:quick": "npm run validate:architecture && npm run validate:error-contract && npm run validate:ui-contract && npm run check:source-size && npm run typecheck && npm run build:frontend",
    "check:source-size": "node scripts/validate_source_size_budget.mjs",
    "validate:error-contract": "node scripts/validate_error_contract.mjs",
    "build:installer": "tauri build --bundles nsis",
    "validate:ui-contract": "node scripts/validate_ui_contract.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.26.0",
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.0.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
